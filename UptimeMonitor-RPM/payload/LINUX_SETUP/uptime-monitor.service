[Unit]
Description=Uptime Monitoring
After=network.target
Wants=network-online.target

[Service]
Type=simple
# Replace with the OS user that should own the app (e.g. the service account
# you created for it). Do NOT run as root.
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/opt/uptime-monitor

# Load configuration (SECRET_KEY, ENCRYPTION_KEY, COOKIE_SECURE, etc.) from .env
EnvironmentFile=-/opt/uptime-monitor/.env
Environment="PYTHONIOENCODING=utf-8"
Environment="PYTHONUNBUFFERED=1"

# Production WSGI server. Keep --workers 1: the background monitoring loops and
# the in-memory login rate limiter assume a single process.
ExecStart=/opt/uptime-monitor/venv/bin/gunicorn \
    --workers 1 \
    --worker-class sync \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --keep-alive 5 \
    --access-logfile /opt/uptime-monitor/logs/access.log \
    --error-logfile /opt/uptime-monitor/logs/error.log \
    --log-level info \
    app:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
